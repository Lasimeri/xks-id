[Unit]
Description=xks-id: reads the turns XKS-Memory records and reports prompt injection
Documentation=https://github.com/Lasimeri/xks-id

[Service]
# One cycle every 2 seconds over the new turn files; a desktop notification per batch of alerts.
ExecStart=%h/.local/bin/xksid watch --interval 2 --notify
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
