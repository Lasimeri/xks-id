{
  "hooks": {
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/xksid hook", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/xksid hook", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/xksid hook", "timeout": 5 } ] }
    ]
  }
}
